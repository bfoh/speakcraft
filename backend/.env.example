# Optional local interactive API docs. Export this value before starting uvicorn.
# This file is a reference; the application does not load it automatically.
SPEAKCRAFT_DOCS_ENABLED=true

# Set both values in the server environment to enable the internal pilot
# speech and feedback endpoints. Never commit real values or put OPENAI_API_KEY in Flutter.
# OPENAI_API_KEY=your-server-only-key
# SPEAKCRAFT_PILOT_TOKEN=generate-a-long-random-value
# SPEAKCRAFT_FEEDBACK_MODEL=gpt-6-astra
